<?xml version="1.0" encoding="utf-8"?>
<!-- Botón oficial «Agregar a la Billetera de Google», armado como lo indica Google
     (developers.google.com/wallet/generic/resources/brand-guidelines, recursos
     Android XML en res/drawable*/googlewallet_* y add_to_googlewallet_*). No se
     redibuja ni se recolorea: las guías lo piden tal cual. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/googlewallet_button_background"
    android:clickable="true"
    android:focusable="true"
    android:padding="2dp"
    android:contentDescription="Agregar a la Billetera de Google">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_centerInParent="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:adjustViewBounds="true"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/add_to_googlewallet_button_content" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/googlewallet_button_overlay" />
</RelativeLayout>
